# Copy to .env and edit; every setting is optional. `xueer-speaker serve -h`
# lists them all (flag -foo-bar = XS_FOO_BAR).

# Where the speaker reaches this machine. Empty = learnt the first time you
# open the panel from another device (not localhost).
# XS_BASE=http://192.168.1.10:8100

# Which speaker on the account (name, did or MAC). Empty = pick in the panel.
# XS_SPEAKER=

# The voice's name and what it calls you.
# XS_PERSONA=雪儿
# XS_OWNER=主人

# Time zone for the panel's schedules.
# TZ=Asia/Shanghai

# Play music from Husic (https://github.com/hardware661/Husic): its address
# and a file with the key from Husic's -service-key-file.
# XS_HUSIC=http://husic:18788
# XS_HUSIC_KEY=/data/husic.key

# A reverse proxy in front logs the user in and sets X-Owner-User; the panel
# trusts it instead of its own password. Only with such a proxy!
# XS_AUTH=header
